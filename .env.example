# Copie para .env.local e preencha. .env.local NUNCA vai para o repositorio.

# URL canonica. Enquanto for *.vercel.app o Meta nao verifica o dominio
# (Public Suffix List) — trocar assim que houver dominio proprio.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Opcional: código fornecido pelo Google Search Console para validar o domínio.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# --- Sanity (Fase 3) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
# Somente servidor: grava lead e roda o import. Escopo de escrita.
SANITY_API_WRITE_TOKEN=""
# Segredo compartilhado com o webhook do Studio que dispara updateTag.
SANITY_REVALIDATE_SECRET=""
# Segredo longo e aleatorio usado para anonimizar IPs no controle antiabuso.
# Se vazio, o servidor usa SANITY_REVALIDATE_SECRET como fallback.
LEAD_SECURITY_SECRET=""

# --- Meta / Conversions API (Fase 6) ---
NEXT_PUBLIC_META_PIXEL_ID=""
# Somente servidor.
META_CAPI_ACCESS_TOKEN=""
# Versao da Graph API. Atualize somente depois de validar no Events Manager.
META_GRAPH_API_VERSION="v23.0"
# Opcional: libera eventos de teste no Events Manager.
META_CAPI_TEST_EVENT_CODE=""

# --- Notificacao de lead (Fase 6) ---
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Claudio Corretor <leads@seu-dominio.com>"
LEAD_NOTIFICACAO_EMAIL="claudioshema2009@gmail.com"

# Copie para .env.local e preencha. .env.local NUNCA vai para o repositorio.

# URL canonica. Enquanto for *.vercel.app o Meta nao verifica o dominio
# (Public Suffix List) — trocar assim que houver dominio proprio.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Sanity (Fase 3) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
# Somente servidor: grava lead e roda o import. Escopo de escrita.
SANITY_API_WRITE_TOKEN=""
# Segredo compartilhado com o webhook do Studio que dispara updateTag.
SANITY_REVALIDATE_SECRET=""

# --- Meta / Conversions API (Fase 6) ---
NEXT_PUBLIC_META_PIXEL_ID=""
# Somente servidor.
META_CAPI_ACCESS_TOKEN=""
# Opcional: libera eventos de teste no Events Manager.
META_CAPI_TEST_EVENT_CODE=""

# --- Notificacao de lead (Fase 6) ---
RESEND_API_KEY=""
LEAD_NOTIFICACAO_EMAIL="claudioshema2009@gmail.com"
